<div class="p-0 flex flex-col h-[85vh] max-h-[850px] w-full">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 p-4 shrink-0 bg-white dark:bg-slate-900 rounded-t-xl">
        <div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white line-clamp-1">{{ rootMessage.subject }}</h3>
            <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                 {% if rootMessage.contextType %}
                    <span class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-slate-600 dark:text-slate-300 font-medium">
                        {{ rootMessage.contextType|capitalize }}
                    </span>
                {% endif %}
                <span>Iniciado em {{ rootMessage.sentAt|date('d/m/Y') }}</span>
            </div>
        </div>
        <button type="button" onclick="document.getElementById('message-modal').close()" class="text-slate-500 bg-slate-100 hover:bg-slate-200 hover:text-slate-800 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white p-2.5 rounded-full transition-colors">
            <sl-icon name="x-lg" label="Fechar"></sl-icon>
        </button>
    </div>

    <!-- Verse Context Area (Grego/Original + Almeida Strong) -->
    {% if verseContext %}
        <div class="p-4 bg-slate-100/70 dark:bg-slate-950/80 border-b border-slate-200 dark:border-slate-800 space-y-3 shrink-0 max-h-[280px] overflow-y-auto">
            {% if verseContext.originalHtml %}
                <div class="bg-white dark:bg-slate-900 p-3.5 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                            <sl-icon name="translate" class="text-xs text-blue-500"></sl-icon>
                            Original ({{ verseContext.originalLanguage }})
                        </span>
                        {% if verseContext.book and verseContext.book.id %}
                            <a href="{{ path('app_translation_verse', {bookId: verseContext.book.id, chapter: verseContext.chapter, verseNum: verseContext.verseNum}) }}" 
                               target="_blank" 
                               class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 inline-flex items-center gap-1">
                                <span>{{ verseContext.book.name }} {{ verseContext.chapter }}:{{ verseContext.verseNum }}</span>
                                <sl-icon name="box-arrow-up-right" class="text-[10px]"></sl-icon>
                            </a>
                        {% else %}
                            <span class="text-xs font-medium text-slate-600 dark:text-slate-400">
                                {{ verseContext.book.name }} {{ verseContext.chapter }}:{{ verseContext.verseNum }}
                            </span>
                        {% endif %}
                    </div>
                    <p class="font-serif text-base leading-relaxed text-slate-900 dark:text-slate-100">
                        {{ verseContext.originalHtml|raw }}
                    </p>
                </div>
            {% endif %}

            {% if verseContext.almeidaHtml %}
                <div class="bg-amber-50/60 dark:bg-amber-950/20 p-3.5 rounded-xl border border-amber-200/60 dark:border-amber-900/40 shadow-sm">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400 flex items-center gap-1.5">
                            <sl-icon name="book" class="text-xs text-amber-600"></sl-icon>
                            Almeida (Strong)
                        </span>
                    </div>
                    <p class="font-serif text-base leading-relaxed text-slate-900 dark:text-slate-100">
                        {{ verseContext.almeidaHtml|raw }}
                    </p>
                </div>
            {% endif %}
        </div>
    {% endif %}

    <!-- Conversation Area -->
    <div class="flex-1 overflow-y-auto p-4 space-y-6 bg-slate-50 dark:bg-slate-950" id="conversation-container">
        {% for msg in conversation %}
            {% set isMe = (msg.sender == app.user) %}
            <div class="flex {{ isMe ? 'justify-end' : 'justify-start' }}">
                <div class="flex flex-col {{ isMe ? 'items-end' : 'items-start' }} max-w-[85%]">
                    
                    <div class="flex items-baseline gap-2 mb-1 px-1">
                        <span class="text-xs font-semibold {{ isMe ? 'text-blue-900 dark:text-blue-300' : 'text-slate-700 dark:text-slate-300' }}">{{ msg.sender.name }}</span>
                        <span class="text-[10px] text-slate-400">{{ msg.sentAt|date('d/m/Y H:i') }}</span>
                    </div>

                    <div class="relative px-4 py-3 rounded-2xl text-sm shadow-sm {{ isMe ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 border border-slate-200 dark:border-slate-700 rounded-tl-none' }}">
                        {{ msg.content|nl2br }}
                    </div>
                    
                    <!-- Status Indicators for 'Me' -->
                    {% if isMe %}
                        <div class="text-[10px] text-slate-400 mt-1 pr-1 flex items-center gap-1">
                            {% if msg.status == 'read' or msg.status == 'replied' or msg.status == 'resolved' %}
                                <sl-icon name="check-all" class="text-blue-500 text-xs"></sl-icon> Lida
                            {% else %}
                                <sl-icon name="check" class="text-slate-400 text-xs"></sl-icon> Enviada
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Footer / Reply Form -->
    <div class="border-t border-slate-200 dark:border-slate-800 p-4 bg-white dark:bg-slate-900 rounded-b-xl shrink-0">
        <form action="{{ path('app_admin_message_reply', {id: conversation|last.id}) }}" method="post" class="flex gap-3 items-end">
            <div class="flex-1">
                <textarea name="content" class="w-full p-3 border border-slate-300 dark:border-slate-700 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-800 transition-colors" rows="2" placeholder="Digite sua resposta..." required></textarea>
            </div>
            <button type="submit" class="h-11 px-4 bg-blue-600 text-white rounded-xl hover:bg-blue-700 shadow-lg shadow-blue-600/20 transition-all transform active:scale-95 flex items-center justify-center shrink-0">
                <sl-icon name="send" class="text-lg"></sl-icon>
            </button>
        </form>
    </div>
</div>

