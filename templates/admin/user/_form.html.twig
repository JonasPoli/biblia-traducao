{# Form customizado para User #}
{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    <div class="grid gap-6 md:grid-cols-2">
        <div class="space-y-2">
            {{ form_label(form.name, 'Nome', {'label_attr': {'class': 'text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400'}}) }}
            {{ form_widget(form.name, {
                'attr': {
                    'class': 'w-full rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none dark:border-white/10 dark:bg-slate-900/60 dark:text-white dark:placeholder:text-slate-500',
                    'placeholder': 'Nome completo'
                }
            }) }}
            {{ form_errors(form.name) }}
        </div>
        <div class="space-y-2">
            {{ form_label(form.email, 'E-mail', {'label_attr': {'class': 'text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400'}}) }}
            {{ form_widget(form.email, {
                'attr': {
                    'class': 'w-full rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none dark:border-white/10 dark:bg-slate-900/60 dark:text-white dark:placeholder:text-slate-500',
                    'placeholder': 'email@exemplo.com'
                }
            }) }}
            {{ form_errors(form.email) }}
        </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
        <div class="space-y-2">
            {{ form_label(form.username, null, {'label_attr': {'class': 'text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400'}}) }}
            {{ form_widget(form.username, {
                'attr': {
                    'class': 'w-full rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none dark:border-white/10 dark:bg-slate-900/60 dark:text-white dark:placeholder:text-slate-500'
                }
            }) }}
            {{ form_help(form.username) }}
            {{ form_errors(form.username) }}
        </div>
        <div class="space-y-2">
            {{ form_label(form.workGroup, null, {'label_attr': {'class': 'text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400'}}) }}
            {{ form_widget(form.workGroup, {
                'attr': {
                    'class': 'w-full rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none dark:border-white/10 dark:bg-slate-900/60 dark:text-white dark:placeholder:text-slate-500'
                }
            }) }}
            {{ form_errors(form.workGroup) }}
        </div>
    </div>

    <div class="space-y-2">
         {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400'}}) }}
        {{ form_widget(form.plainPassword, {
            'attr': {
                'class': 'w-full rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none dark:border-white/10 dark:bg-slate-900/60 dark:text-white dark:placeholder:text-slate-500'
            }
        }) }}
        {{ form_help(form.plainPassword) }}
        {{ form_errors(form.plainPassword) }}
    </div>

    <div class="flex justify-end gap-2">
        <sl-button variant="default" outline href="{{ path('app_admin_user_index') }}">Cancelar</sl-button>
        <sl-button variant="primary" type="submit">
            <sl-icon slot="prefix" name="check2"></sl-icon>
            {{ button_label|default('Salvar') }}
        </sl-button>
    </div>
{{ form_end(form) }}
