{% extends 'admin/base.html.twig' %}

{% block body %}
<div class="space-y-8">
    <section class="flex flex-wrap items-center justify-between gap-4 rounded-[32px] bg-white/80 p-6 shadow-xl shadow-slate-900/5 ring-1 ring-white/70 backdrop-blur dark:bg-slate-900/70 dark:ring-white/10">
        <div class="flex items-center gap-4">
            <div class="h-16 w-16 flex-shrink-0">
                {% if user.image %}
                    <img class="h-16 w-16 rounded-full object-cover ring-2 ring-white dark:ring-slate-800" src="{{ asset('uploads/avatars/' ~ user.image) }}" alt="{{ user.name }}">
                {% else %}
                    <div class="flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-500 ring-2 ring-white dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-800">
                        <sl-icon name="person" class="text-3xl"></sl-icon>
                    </div>
                {% endif %}
            </div>
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-500 dark:text-slate-400">Detalhes</p>
                <h1 class="mt-1 text-3xl font-semibold text-slate-900 dark:text-white">{{ user.name }}</h1>
                <p class="text-sm text-slate-500 dark:text-slate-400">Username: {{ user.username }}</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-3">
            <sl-button variant="default" outline href="{{ path('app_admin_user_edit', {'id': user.id}) }}">
                <sl-icon slot="prefix" name="pencil-square"></sl-icon>
                Editar
            </sl-button>
            <sl-button variant="default" outline href="{{ path('app_admin_user_index') }}">
                <sl-icon slot="prefix" name="arrow-left"></sl-icon>
                Voltar
            </sl-button>
        </div>
    </section>

    <sl-card class="border-none bg-white/85 shadow-lg shadow-slate-900/5 ring-1 ring-white/70 backdrop-blur dark:bg-slate-900/70 dark:ring-white/10">
        <div class="grid gap-6 sm:grid-cols-2">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Nome</p>
                <p class="mt-2 text-lg font-semibold text-slate-900 dark:text-white">{{ user.name }}</p>
            </div>
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">E-mail</p>
                <p class="mt-2 text-lg font-medium text-slate-700 dark:text-slate-300">{{ user.email }}</p>
            </div>
             <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Usuário</p>
                <p class="mt-2 font-mono text-sm text-slate-600 dark:text-slate-300">{{ user.username }}</p>
            </div>
             <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Grupo</p>
                <p class="mt-2 text-lg font-semibold text-slate-900 dark:text-white">
                    {% if user.workGroup == 0 %}Administrador
                    {% elseif user.workGroup == 1 %}Tradutor
                    {% elseif user.workGroup == 2 %}Revisor de Tradução
                    {% elseif user.workGroup == 3 %}Autor de Paratextos
                    {% elseif user.workGroup == 4 %}Revisor de Paratextos
                    {% else %}Desconhecido ({{ user.workGroup }}){% endif %}
                </p>
            </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
            <sl-button variant="danger" outline onclick="document.getElementById('delete-form').requestSubmit()">
                <sl-icon slot="prefix" name="trash"></sl-icon>
                Remover
            </sl-button>
        </div>
    </sl-card>

    <form id="delete-form" method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    </form>
</div>
{% endblock %}
