{% extends 'admin/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.3/css/dataTables.dataTables.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.3/js/dataTables.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof window.jQuery === 'undefined' || typeof window.jQuery.fn.DataTable === 'undefined') {
                return;
            }

            $('#user-table').DataTable({
                pageLength: 50,
                responsive: true,
                language: {
                    search: 'Buscar:',
                    info: 'Mostrando _START_ até _END_ de _TOTAL_ registros',
                    infoEmpty: 'Nenhum registro disponível',
                    lengthMenu: 'Mostrar _MENU_ itens',
                    paginate: {
                        first: 'Primeiro',
                        last: 'Último',
                        next: 'Próximo',
                        previous: 'Anterior'
                    },
                    zeroRecords: 'Nada encontrado'
                }
            });
        });
    </script>
{% endblock %}

{% block body %}
<div class="space-y-8">
    <section class="rounded-[32px] bg-white/80 p-6 shadow-xl shadow-slate-900/5 ring-1 ring-white/70 backdrop-blur dark:bg-slate-900/70 dark:ring-white/10">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-500 dark:text-slate-400">Administração</p>
                <h1 class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">Gerenciamento de Usuários</h1>
                <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
                    Uma lista de todos os usuários incluindo nome, título, email e permissões.
                </p>
            </div>
            <div class="flex flex-wrap gap-3">
                <sl-button size="large" variant="primary" outline href="{{ path('app_admin_user_import') }}">
                    <sl-icon slot="prefix" name="cloud-upload"></sl-icon>
                    Importar Usuários (CSV)
                </sl-button>
                <sl-button size="large" variant="default" outline href="{{ path('app_admin_user_new') }}">
                    <sl-icon slot="prefix" name="person-plus"></sl-icon>
                    Adicionar Usuário
                </sl-button>
            </div>
        </div>
    </section>

    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <sl-alert variant="{{ label == 'success' ? 'success' : 'danger' }}" open closable class="mb-4">
                <sl-icon slot="icon" name="{{ label == 'success' ? 'check2-circle' : 'exclamation-octagon' }}"></sl-icon>
                {{ message }}
            </sl-alert>
        {% endfor %}
    {% endfor %}

    <sl-card class="border-none bg-white/85 shadow-lg shadow-slate-900/5 ring-1 ring-white/70 backdrop-blur dark:bg-slate-900/70 dark:ring-white/10">
        <div slot="header" class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <p class="text-lg font-semibold text-slate-900 dark:text-white">Lista de Usuários</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                    Gerencie o acesso e as funções dos membros da equipe.
                </p>
            </div>
        </div>

        {% if users is empty %}
            <sl-alert variant="neutral" open>
                <sl-icon slot="icon" name="inbox"></sl-icon>
                Nenhum usuário encontrado. Comece criando um novo usuário.
            </sl-alert>
        {% else %}
            <div class="overflow-x-auto">
                <table id="user-table" class="min-w-full divide-y divide-slate-100 dark:divide-white/5">
                    <thead class="bg-slate-50/50 dark:bg-slate-700/20">
                        <tr class="text-left text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
                            <th scope="col" class="py-3.5 pl-4 pr-3 sm:pl-6">ID</th>
                            <th scope="col" class="px-3 py-3.5">Usuário</th>
                            <th scope="col" class="px-3 py-3.5">Grupo</th>
                            <th scope="col" class="px-3 py-3.5">Username</th>
                            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                        {% for user in users %}
                            <tr class="group hover:bg-slate-50/70 dark:hover:bg-white/5 transition-colors">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-mono text-slate-500 dark:text-slate-400 sm:pl-6">#{{ user.id }}</td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm">
                                    <div class="flex items-center">
                                        <div class="h-10 w-10 flex-shrink-0">
                                            {% if user.image %}
                                                <img class="h-10 w-10 rounded-full object-cover" src="{{ asset('uploads/avatars/' ~ user.image) }}" alt="">
                                            {% else %}
                                                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                                                    <sl-icon name="person" class="text-xl"></sl-icon>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="ml-4">
                                            <div class="font-medium text-slate-900 dark:text-white">{{ user.name }}</div>
                                            <div class="text-slate-500 dark:text-slate-400">{{ user.email }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm">
                                    {% if user.workGroup == 0 %}<span class="inline-flex items-center rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Admin</span>
                                    {% elseif user.workGroup == 1 %}<span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">Tradutor</span>
                                    {% elseif user.workGroup == 2 %}<span class="inline-flex items-center rounded-full bg-yellow-50 px-2.5 py-0.5 text-xs font-medium text-yellow-800 ring-1 ring-inset ring-yellow-600/20">Revisor Trad.</span>
                                    {% elseif user.workGroup == 3 %}<span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Autor Paratexto</span>
                                    {% elseif user.workGroup == 4 %}<span class="inline-flex items-center rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">Revisor Paratexto</span>
                                    {% else %}<span class="inline-flex items-center rounded-full bg-slate-50 px-2.5 py-0.5 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">Desconhecido</span>{% endif %}
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500 dark:text-slate-400 font-mono">{{ user.username }}</td>
                                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                    <div class="flex justify-end gap-2 opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity">
                                        <form method="post" action="{{ path('app_admin_user_send_reset_link', {'id': user.id}) }}" onsubmit="return confirm('Deseja enviar um e-mail com link de definição de senha para {{ user.name }} ({{ user.email }})?');" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('send_reset_' ~ user.id) }}">
                                            <sl-tooltip content="Enviar Link de Definição de Senha por E-mail">
                                                <sl-button type="submit" size="small" variant="primary" outline circle class="hover:shadow-md transition-shadow">
                                                    <sl-icon name="envelope-arrow-up" label="Enviar Senha"></sl-icon>
                                                </sl-button>
                                            </sl-tooltip>
                                        </form>
                                        <a href="{{ path('app_dashboard', {'_switch_user': user.username}) }}" target="_blank" title="Impersonar" class="text-amber-600 hover:text-amber-900">
                                            <sl-button size="small" variant="warning" outline circle class="hover:shadow-md transition-shadow">
                                                <sl-icon name="person-lines-fill" label="Impersonar"></sl-icon>
                                            </sl-button>
                                        </a>
                                        <a href="{{ path('app_admin_user_show', {'id': user.id}) }}" title="Ver Detalhes">
                                            <sl-button size="small" variant="default" circle class="hover:shadow-md transition-shadow">
                                                <sl-icon name="eye" label="Ver"></sl-icon>
                                            </sl-button>
                                        </a>
                                        <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" title="Editar Usuário">
                                            <sl-button size="small" variant="default" circle class="hover:shadow-md transition-shadow">
                                                <sl-icon name="pencil" label="Editar"></sl-icon>
                                            </sl-button>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </sl-card>
 </div>
{% endblock %}
