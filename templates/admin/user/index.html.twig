{% extends 'admin/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.3/css/dataTables.dataTables.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.3/js/dataTables.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof window.jQuery === 'undefined' || typeof window.jQuery.fn.DataTable === 'undefined') {
                return;
            }

            $('#user-table').DataTable({
                pageLength: 50,
                responsive: true,
                language: {
                    search: 'Buscar:',
                    info: 'Mostrando _START_ até _END_ de _TOTAL_ registros',
                    infoEmpty: 'Nenhum registro disponível',
                    lengthMenu: 'Mostrar _MENU_ itens',
                    paginate: {
                        first: 'Primeiro',
                        last: 'Último',
                        next: 'Próximo',
                        previous: 'Anterior'
                    },
                    zeroRecords: 'Nada encontrado'
                }
            });
        });
    </script>
{% endblock %}

{% block body %}
 <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Gerenciamento de Usuários</h1>
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Uma lista de todos os usuários incluindo nome, título, email e permissões.</p>
        </div>
        <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
            <a href="{{ path('app_admin_user_new') }}">
                <sl-button variant="primary" size="medium" class="shadow-sm">
                    <sl-icon slot="prefix" name="person-plus"></sl-icon>
                    Adicionar Usuário
                </sl-button>
            </a>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg ring-1 ring-slate-900/5 overflow-hidden">
        {% if users is empty %}
            <div class="p-12 text-center text-slate-500 dark:text-slate-400">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-700 mb-4">
                    <sl-icon name="inbox" class="text-3xl text-slate-400"></sl-icon>
                </div>
                <h3 class="text-lg font-medium text-slate-900 dark:text-white">Nenhum usuário encontrado</h3>
                <p class="mt-1 text-sm text-slate-500">Comece criando um novo usuário.</p>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table id="user-table" class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                    <thead class="bg-slate-50 dark:bg-slate-700/50">
                        <tr>
                            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 sm:pl-6">ID</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Usuário</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Grupo</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Username</th>
                            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-800">
                        {% for user in users %}
                            <tr class="group hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-mono text-slate-500 dark:text-slate-400 sm:pl-6">#{{ user.id }}</td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm">
                                    <div class="font-medium text-slate-900 dark:text-white">{{ user.name }}</div>
                                    <div class="text-slate-500 dark:text-slate-400">{{ user.email }}</div>
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm">
                                    {% if user.workGroup == 0 %}<span class="inline-flex items-center rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Admin</span>
                                    {% elseif user.workGroup == 1 %}<span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">Tradutor</span>
                                    {% elseif user.workGroup == 2 %}<span class="inline-flex items-center rounded-full bg-yellow-50 px-2.5 py-0.5 text-xs font-medium text-yellow-800 ring-1 ring-inset ring-yellow-600/20">Revisor Trad.</span>
                                    {% elseif user.workGroup == 3 %}<span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Autor Paratexto</span>
                                    {% elseif user.workGroup == 4 %}<span class="inline-flex items-center rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">Revisor Paratexto</span>
                                    {% else %}<span class="inline-flex items-center rounded-full bg-slate-50 px-2.5 py-0.5 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">Desconhecido</span>{% endif %}
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500 dark:text-slate-400 font-mono">{{ user.username }}</td>
                                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                    <div class="flex justify-end gap-2 opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity">
                                        <a href="{{ path('app_dashboard', {'_switch_user': user.username}) }}" target="_blank" title="Impersonar" class="text-amber-600 hover:text-amber-900">
                                            <sl-button size="small" variant="warning" outline circle class="hover:shadow-md transition-shadow">
                                                <sl-icon name="person-lines-fill" label="Impersonar"></sl-icon>
                                            </sl-button>
                                        </a>
                                        <a href="{{ path('app_admin_user_show', {'id': user.id}) }}" title="Ver Detalhes">
                                            <sl-button size="small" variant="default" circle class="hover:shadow-md transition-shadow">
                                                <sl-icon name="eye" label="Ver"></sl-icon>
                                            </sl-button>
                                        </a>
                                        <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" title="Editar Usuário">
                                            <sl-button size="small" variant="default" circle class="hover:shadow-md transition-shadow">
                                                <sl-icon name="pencil" label="Editar"></sl-icon>
                                            </sl-button>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
 </div>
{% endblock %}
