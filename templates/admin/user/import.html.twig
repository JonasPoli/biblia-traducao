{% extends 'admin/base.html.twig' %}

{% block title %}Importar Usuários - Administração{% endblock %}

{% block body %}
<div class="space-y-8">
    {# Header Section #}
    <section class="rounded-[32px] bg-white/80 p-6 shadow-xl shadow-slate-900/5 ring-1 ring-white/70 backdrop-blur dark:bg-slate-900/70 dark:ring-white/10">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-500 dark:text-slate-400">Administração &bull; Usuários</p>
                <h1 class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">Importar Usuários em Lote</h1>
                <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
                    Envie um arquivo CSV com os dados dos membros da equipe. O sistema cadastrará as contas e disparará os e-mails com links para criação de senha.
                </p>
            </div>
            <div class="flex flex-wrap gap-3">
                <sl-button size="large" variant="default" outline href="{{ path('app_admin_user_index') }}">
                    <sl-icon slot="prefix" name="arrow-left"></sl-icon>
                    Voltar para a Lista
                </sl-button>
                <sl-button size="large" variant="primary" outline href="{{ path('app_admin_user_import_template') }}">
                    <sl-icon slot="prefix" name="download"></sl-icon>
                    Baixar Modelo CSV
                </sl-button>
            </div>
        </div>
    </section>

    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <sl-alert variant="{{ label == 'success' ? 'success' : 'danger' }}" open closable class="mb-4">
                <sl-icon slot="icon" name="{{ label == 'success' ? 'check2-circle' : 'exclamation-octagon' }}"></sl-icon>
                {{ message }}
            </sl-alert>
        {% endfor %}
    {% endfor %}

    {# Import Results (if available) #}
    {% if result %}
        <div class="space-y-6">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <sl-icon name="clipboard-check" class="text-green-500 text-2xl"></sl-icon>
                Relatório da Importação
            </h2>

            {# Stat counters #}
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
                <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800 text-center">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Processado</p>
                    <p class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">{{ result.total }}</p>
                </div>
                <div class="rounded-2xl bg-green-50/80 p-4 shadow-sm ring-1 ring-green-200 dark:bg-green-950/30 dark:ring-green-900/50 text-center">
                    <p class="text-xs font-semibold uppercase tracking-wider text-green-700 dark:text-green-400">Criados</p>
                    <p class="mt-1 text-2xl font-bold text-green-700 dark:text-green-400">{{ result.created|length }}</p>
                </div>
                <div class="rounded-2xl bg-blue-50/80 p-4 shadow-sm ring-1 ring-blue-200 dark:bg-blue-950/30 dark:ring-blue-900/50 text-center">
                    <p class="text-xs font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-400">E-mails Enviados</p>
                    <p class="mt-1 text-2xl font-bold text-blue-700 dark:text-blue-400">{{ result.emails_sent }}</p>
                </div>
                <div class="rounded-2xl bg-amber-50/80 p-4 shadow-sm ring-1 ring-amber-200 dark:bg-amber-950/30 dark:ring-amber-900/50 text-center">
                    <p class="text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-400">Atualizados</p>
                    <p class="mt-1 text-2xl font-bold text-amber-700 dark:text-amber-400">{{ result.updated|length }}</p>
                </div>
                <div class="rounded-2xl bg-slate-50 p-4 shadow-sm ring-1 ring-slate-200 dark:bg-slate-800/60 dark:ring-slate-700 text-center">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Ignorados (Existentes)</p>
                    <p class="mt-1 text-2xl font-bold text-slate-700 dark:text-slate-300">{{ result.skipped|length }}</p>
                </div>
                <div class="rounded-2xl bg-red-50/80 p-4 shadow-sm ring-1 ring-red-200 dark:bg-red-950/30 dark:ring-red-900/50 text-center">
                    <p class="text-xs font-semibold uppercase tracking-wider text-red-700 dark:text-red-400">Erros</p>
                    <p class="mt-1 text-2xl font-bold text-red-700 dark:text-red-400">{{ result.errors|length }}</p>
                </div>
            </div>

            {# Detailed table #}
            <div class="overflow-hidden rounded-2xl bg-white shadow ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-sm">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                        <tr>
                            <th class="py-3.5 pl-4 pr-3 sm:pl-6">Nome</th>
                            <th class="px-3 py-3.5">E-mail</th>
                            <th class="px-3 py-3.5">Grupo</th>
                            <th class="px-3 py-3.5">Status</th>
                            <th class="px-3 py-3.5">E-mail de Senha</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {% for item in result.created %}
                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                <td class="py-3 pl-4 pr-3 font-medium text-slate-900 dark:text-white sm:pl-6">{{ item.name }}</td>
                                <td class="px-3 py-3 text-slate-600 dark:text-slate-300">{{ item.email }}</td>
                                <td class="px-3 py-3">
                                    <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-800 dark:bg-slate-800 dark:text-slate-200">
                                        Grupo {{ item.workGroup }}
                                    </span>
                                </td>
                                <td class="px-3 py-3">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-700 dark:bg-green-950/40 dark:text-green-300">
                                        <sl-icon name="check-circle" class="text-xs"></sl-icon> Criado
                                    </span>
                                </td>
                                <td class="px-3 py-3">
                                    {% if item.emailSent %}
                                        <span class="text-xs font-medium text-green-600 dark:text-green-400 flex items-center gap-1">
                                            <sl-icon name="send-check"></sl-icon> Enviado
                                        </span>
                                    {% else %}
                                        <span class="text-xs text-slate-400">Não enviado</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}

                        {% for item in result.updated %}
                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                <td class="py-3 pl-4 pr-3 font-medium text-slate-900 dark:text-white sm:pl-6">{{ item.name }}</td>
                                <td class="px-3 py-3 text-slate-600 dark:text-slate-300">{{ item.email }}</td>
                                <td class="px-3 py-3">
                                    <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-800 dark:bg-slate-800 dark:text-slate-200">
                                        Grupo {{ item.workGroup }}
                                    </span>
                                </td>
                                <td class="px-3 py-3">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700 dark:bg-amber-950/40 dark:text-amber-300">
                                        <sl-icon name="arrow-repeat" class="text-xs"></sl-icon> Atualizado
                                    </span>
                                </td>
                                <td class="px-3 py-3">
                                    {% if item.emailSent %}
                                        <span class="text-xs font-medium text-green-600 dark:text-green-400 flex items-center gap-1">
                                            <sl-icon name="send-check"></sl-icon> Enviado
                                        </span>
                                    {% else %}
                                        <span class="text-xs text-slate-400">Não enviado</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}

                        {% for item in result.skipped %}
                            <tr class="opacity-70 hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                <td class="py-3 pl-4 pr-3 text-slate-700 dark:text-slate-300 sm:pl-6">{{ item.name }}</td>
                                <td class="px-3 py-3 text-slate-600 dark:text-slate-400">{{ item.email }}</td>
                                <td class="px-3 py-3 text-slate-400">-</td>
                                <td class="px-3 py-3">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                                        Ignorado (Já existe)
                                    </span>
                                </td>
                                <td class="px-3 py-3 text-slate-400">-</td>
                            </tr>
                        {% endfor %}

                        {% for item in result.errors %}
                            <tr class="bg-red-50/30 dark:bg-red-950/20">
                                <td class="py-3 pl-4 pr-3 text-red-700 dark:text-red-300 sm:pl-6">{{ item.row.name|default('-') }}</td>
                                <td class="px-3 py-3 text-red-700 dark:text-red-300">{{ item.row.email|default('-') }}</td>
                                <td class="px-3 py-3 text-slate-400">-</td>
                                <td class="px-3 py-3" colspan="2">
                                    <span class="text-xs font-semibold text-red-600 dark:text-red-400">{{ item.message }}</span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {# Import Form & Instructions #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        {# Form Section #}
        <div class="lg:col-span-2 space-y-6">
            <div class="rounded-3xl bg-white p-6 sm:p-8 shadow-xl shadow-slate-900/5 ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
                <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
                    <sl-icon name="upload" class="text-blue-600 dark:text-blue-400"></sl-icon>
                    Enviar Dados dos Usuários
                </h2>

                <form method="post" enctype="multipart/form-data" class="space-y-6">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_import') }}">

                    {# Option 1: File Upload #}
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                            Opção 1: Enviar Arquivo CSV (.csv)
                        </label>
                        <input type="file" 
                               name="csv_file" 
                               accept=".csv,text/csv,text/plain"
                               class="block w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-blue-950/50 dark:file:text-blue-300 cursor-pointer border border-slate-300 dark:border-slate-700 rounded-xl p-2 bg-slate-50 dark:bg-slate-800">
                    </div>

                    <div class="relative flex py-2 items-center">
                        <div class="flex-grow border-t border-slate-200 dark:border-slate-700"></div>
                        <span class="flex-shrink mx-4 text-xs uppercase tracking-wider text-slate-400 font-semibold">ou cole o texto</span>
                        <div class="flex-grow border-t border-slate-200 dark:border-slate-700"></div>
                    </div>

                    {# Option 2: Textarea Direct Paste #}
                    <div>
                        <label for="csv_content" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                            Opção 2: Colar Linhas CSV Diretamente
                        </label>
                        <textarea id="csv_content" 
                                  name="csv_content" 
                                  rows="6" 
                                  placeholder="Nome,Email,Grupo de Trabalho&#10;João da Silva,joao@exemplo.com,Tradutor&#10;Maria Santos,maria@exemplo.com,Revisor de Tradução"
                                  class="w-full rounded-2xl border border-slate-300 bg-slate-50 p-4 font-mono text-xs text-slate-900 placeholder-slate-400 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:placeholder-slate-500 transition-colors"></textarea>
                    </div>

                    {# Options checkboxes #}
                    <div class="space-y-3 pt-2 border-t border-slate-100 dark:border-slate-800">
                        <label class="flex items-start gap-3 cursor-pointer">
                            <input type="checkbox" 
                                   name="send_email" 
                                   value="1" 
                                   checked 
                                   class="mt-1 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800">
                            <div>
                                <span class="text-sm font-medium text-slate-900 dark:text-white">Enviar e-mail de definição de senha automaticamente</span>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Cada usuário receberá uma mensagem com o link de 48h para cadastrar sua senha.</p>
                            </div>
                        </label>

                        <label class="flex items-start gap-3 cursor-pointer">
                            <input type="checkbox" 
                                   name="overwrite" 
                                   value="1" 
                                   class="mt-1 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800">
                            <div>
                                <span class="text-sm font-medium text-slate-900 dark:text-white">Atualizar dados se o usuário já existir</span>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Atualiza nome e grupo de trabalho para contas com o mesmo e-mail.</p>
                            </div>
                        </label>
                    </div>

                    {# Submit button #}
                    <div class="pt-4">
                        <button type="submit" 
                                class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-lg shadow-blue-600/20 active:scale-95 transition-all flex items-center justify-center gap-2">
                            <sl-icon name="cloud-upload" class="text-lg"></sl-icon>
                            <span>Processar Importação</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        {# Instructions & Guidance Sidebar #}
        <div class="space-y-6">
            <div class="rounded-3xl bg-slate-50 p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900/60 dark:ring-slate-800 space-y-4">
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="info-circle" class="text-blue-500"></sl-icon>
                    Formato Aceito
                </h3>
                
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    O arquivo pode usar vírgula (<code class="bg-slate-200 dark:bg-slate-800 px-1 py-0.5 rounded font-mono">,</code>) ou ponto e vírgula (<code class="bg-slate-200 dark:bg-slate-800 px-1 py-0.5 rounded font-mono">;</code>) como separador de colunas.
                </p>

                <div class="border-t border-slate-200 dark:border-slate-800 pt-3">
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Grupos de Trabalho (Números ou Nomes)</p>
                    <ul class="text-xs space-y-1.5 text-slate-600 dark:text-slate-400">
                        <li><strong class="text-slate-900 dark:text-slate-200">0 ou Administrador:</strong> Acesso total ao painel</li>
                        <li><strong class="text-slate-900 dark:text-slate-200">1 ou Tradutor:</strong> Tradução de versículos</li>
                        <li><strong class="text-slate-900 dark:text-slate-200">2 ou Revisor de Tradução:</strong> Revisão dos textos</li>
                        <li><strong class="text-slate-900 dark:text-slate-200">3 ou Autor de Paratextos:</strong> Criação de notas/introduções</li>
                        <li><strong class="text-slate-900 dark:text-slate-200">4 ou Revisor de Paratextos:</strong> Revisão dos paratextos</li>
                    </ul>
                </div>

                <div class="border-t border-slate-200 dark:border-slate-800 pt-3">
                    <a href="{{ path('app_admin_user_import_template') }}" 
                       class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
                        <sl-icon name="file-earmark-spreadsheet"></sl-icon>
                        Baixar planilha modelo de exemplo (.csv)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
