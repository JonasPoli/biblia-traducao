{% extends 'admin/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.3/css/dataTables.dataTables.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.3/js/dataTables.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof window.jQuery === 'undefined' || typeof window.jQuery.fn.DataTable === 'undefined') {
                return;
            }

            $('#paratext-table').DataTable({
                pageLength: 25,
                responsive: true,
                language: {
                    search: 'Buscar:',
                    info: 'Mostrando _START_ até _END_ de _TOTAL_ registros',
                    infoEmpty: 'Nenhum registro disponível',
                    lengthMenu: 'Mostrar _MENU_ itens',
                    paginate: {
                        first: 'Primeiro',
                        last: 'Último',
                        next: 'Próximo',
                        previous: 'Anterior'
                    },
                    zeroRecords: 'Nada encontrado'
                }
            });


            });
        });
    </script>
{% endblock %}

{% block body %}
 <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Paratextos</h1>
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Conteúdo Extra (Introduções, Mapas, Artigos)</p>
        </div>
        {% if is_granted('CAN_EDIT_PARATEXT') %}
            <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
                <a href="{{ path('app_admin_paratext_new') }}">
                    <sl-button variant="primary" size="medium" class="shadow-sm">
                        <sl-icon slot="prefix" name="plus-lg"></sl-icon>
                        Novo Conteúdo
                    </sl-button>
                </a>
            </div>
        {% endif %}
    </div>

    {# Approval Legend #}
    <div class="mb-6">
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-800 rounded-lg p-3 border border-slate-200 dark:border-slate-700 shadow-sm">
            <span class="font-semibold mr-2 uppercase tracking-wide text-[10px]">Nível de Aprovação:</span>
            
            <div class="flex items-center gap-1" title="0 Aprovações">
                <div class="w-6 h-6 rounded border border-slate-200 dark:border-slate-600 bg-transparent flex items-center justify-center font-bold">0</div>
            </div>

            <div class="flex items-center gap-1" title="1 Aprovação">
                <div class="w-6 h-6 rounded bg-green-50 text-green-800 border border-green-100 flex items-center justify-center font-bold">1</div>
            </div>
            
            <div class="flex items-center gap-1" title="2 Aprovações">
                <div class="w-6 h-6 rounded bg-green-100 text-green-900 border border-green-200 flex items-center justify-center font-bold">2</div>
            </div>

            <div class="flex items-center gap-1" title="3 Aprovações">
                <div class="w-6 h-6 rounded bg-green-200 text-green-900 border border-green-300 flex items-center justify-center font-bold">3</div>
            </div>
            
            <div class="flex items-center gap-1" title="4 Aprovações">
                <div class="w-6 h-6 rounded bg-green-300 text-green-900 border border-green-400 flex items-center justify-center font-bold">4</div>
            </div>
            
            <div class="flex items-center gap-1" title="5 Aprovações">
                <div class="w-6 h-6 rounded bg-green-400 text-white border border-green-500 flex items-center justify-center font-bold shadow-sm">5</div>
            </div>

            <div class="flex items-center gap-1" title="6 Aprovações">
                <div class="w-6 h-6 rounded bg-green-500 text-white border border-green-600 flex items-center justify-center font-bold shadow-sm">6</div>
            </div>
            
            <div class="flex items-center gap-1" title="7 Aprovações">
                <div class="w-6 h-6 rounded bg-green-600 text-white border border-green-700 flex items-center justify-center font-bold shadow-sm">7</div>
            </div>

            <div class="flex items-center gap-1" title="8 Aprovações">
                <div class="w-6 h-6 rounded bg-green-700 text-white border border-green-800 flex items-center justify-center font-bold shadow-sm">8</div>
            </div>
            
            <div class="flex items-center gap-1" title="9 Aprovações">
                <div class="w-6 h-6 rounded bg-green-800 text-white border border-green-900 flex items-center justify-center font-bold shadow-sm">9</div>
            </div>

            <div class="flex items-center gap-1" title="10 Aprovações">
                <div class="w-6 h-6 rounded bg-green-900 text-white border border-green-950 flex items-center justify-center font-bold shadow-sm">10</div>
            </div>

            <div class="flex items-center gap-1" title="11+ Aprovações">
                <div class="w-8 h-6 rounded bg-green-950 text-white border border-black flex items-center justify-center font-bold shadow-sm">11+</div>
            </div>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg ring-1 ring-slate-900/5 overflow-hidden">
        {% if paratexts is empty %}
            <div class="p-12 text-center text-slate-500 dark:text-slate-400">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-700 mb-4">
                    <sl-icon name="inbox" class="text-3xl text-slate-400"></sl-icon>
                </div>
                <h3 class="text-lg font-medium text-slate-900 dark:text-white">Nenhum paratexto cadastrado</h3>
                <p class="mt-1 text-sm text-slate-500">Comece criando um novo conteúdo.</p>
            </div>
        {% else %}
            <div class="p-8">
                <div class="overflow-x-auto">
                    <table id="paratext-table" class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                        <thead class="bg-slate-50 dark:bg-slate-700/50">
                            <tr>
                                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 sm:pl-6">ID</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Título</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Tipo</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Ref. Bíblica</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Autor</th>
                                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-800">
                            {% for pt in paratexts %}
                                {% set count = reviewCounts[pt.id] ?? 0 %}
                                {% set bgClass = '' %}
                                {% if count == 1 %}{% set bgClass = 'bg-green-50' %}
                                {% elseif count == 2 %}{% set bgClass = 'bg-green-100' %}
                                {% elseif count == 3 %}{% set bgClass = 'bg-green-200' %}
                                {% elseif count == 4 %}{% set bgClass = 'bg-green-300' %}
                                {% elseif count == 5 %}{% set bgClass = 'bg-green-400' %}
                                {% elseif count == 6 %}{% set bgClass = 'bg-green-500' %}
                                {% elseif count == 7 %}{% set bgClass = 'bg-green-600' %}
                                {% elseif count == 8 %}{% set bgClass = 'bg-green-700' %}
                                {% elseif count == 9 %}{% set bgClass = 'bg-green-800' %}
                                {% elseif count == 10 %}{% set bgClass = 'bg-green-900' %}
                                {% elseif count >= 11 %}{% set bgClass = 'bg-green-950' %}
                                {% endif %}

                                <tr class="group hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors {{ bgClass }}">
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-mono text-slate-500 dark:text-slate-400 sm:pl-6">#{{ pt.id }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm font-medium text-slate-900 dark:text-white">
                                        {{ pt.title }}
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        {% set typeLabels = {
                                            'intro_book': 'Introdução por Livro',
                                            'intro_chapter': 'Introdução de Capítulo',
                                            'note_pericope': 'Texto sobre Perícopes',
                                            'note_geo': 'Nota Geográfica',
                                            'note_historical': 'Nota Histórica',
                                            'note_character': 'Nota sobre Personagem',
                                            'note_cultural': 'Nota Cultural',
                                            'note': 'Nota Explicativa',
                                            'map_geo': 'Mapa Geográfico',
                                            'timeline': 'Linha do Tempo',
                                            'genealogy': 'Árvore Genealógica',
                                            'article': 'Artigo',
                                            'introduction': 'Introdução',
                                            'map': 'Mapa'
                                        } %}
                                       <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-800 ring-1 ring-inset ring-slate-600/20">
                                            {{ typeLabels[pt.type]|default(pt.type|capitalize) }}
                                       </span>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-600 dark:text-slate-300">
                                        {% if pt.book %}
                                            <div class="flex items-center gap-1">
                                                <sl-icon name="book" class="text-slate-400"></sl-icon>
                                                {{ pt.book.name }} 
                                                {% if pt.chapter %}{{ pt.chapter }}{% endif %}
                                                {% if pt.verse %}:{{ pt.verse }}{% endif %}
                                            </div>
                                        {% else %}
                                            <span class="text-slate-400">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500 dark:text-slate-400">
                                        {% if pt.author %}
                                            <div class="flex items-center gap-2">
                                                {% if pt.author.image %}
                                                    <img src="{{ asset('uploads/avatars/' ~ pt.author.image) }}" alt="{{ pt.author.name }}" class="w-6 h-6 rounded-full object-cover ring-1 ring-slate-200 dark:ring-slate-700">
                                                {% else %}
                                                    <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-[10px] font-bold text-slate-600 dark:bg-slate-700 dark:text-slate-300">
                                                        {{ pt.author.name|first }}
                                                    </div>
                                                {% endif %}
                                                {{ pt.author.name }}
                                            </div>
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                        <div class="flex justify-end gap-2 opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity">
                                            <a href="{{ path('app_admin_paratext_show', {'id': pt.id}) }}" title="Ver Detalhes">
                                                <sl-button size="small" variant="default" circle class="hover:shadow-md transition-shadow">
                                                    <sl-icon name="eye" label="Ver"></sl-icon>
                                                </sl-button>
                                            </a>
                                            <div title="Revisões" class="flex items-center gap-1 text-xs font-semibold text-slate-500 bg-slate-100 rounded-full px-2 py-1">
                                                <sl-icon name="check-circle-fill" class="text-green-600 text-sm"></sl-icon>
                                                {{ count }}
                                            </div>
                                            {% if is_granted('CAN_EDIT_PARATEXT') %}
                                                <a href="{{ path('app_admin_paratext_edit', {'id': pt.id}) }}" title="Editar">
                                                    <sl-button size="small" variant="default" circle class="hover:shadow-md transition-shadow">
                                                        <sl-icon name="pencil" label="Editar"></sl-icon>
                                                    </sl-button>
                                                </a>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

