{% extends 'pub/base.html.twig' %}

{% block title %}Definir Senha - Tradução do Novo Testamento{% endblock %}

{% block body %}
<div class="flex min-h-[70vh] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
        <div class="rounded-3xl bg-white p-8 shadow-xl shadow-slate-900/5 ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
            {% if not tokenValid %}
                <div class="text-center">
                    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-950/50 dark:text-red-400">
                        <sl-icon name="exclamation-octagon" class="text-3xl"></sl-icon>
                    </div>
                    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Link Inválido ou Expirado</h1>
                    <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                        {{ error|default('Este link de definição de senha não é mais válido ou o prazo de 48 horas expirou.') }}
                    </p>
                    <div class="mt-8">
                        <a href="{{ path('app_login') }}" class="inline-flex w-full justify-center rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white shadow hover:bg-slate-800 dark:bg-blue-600 dark:hover:bg-blue-700 transition-colors">
                            Voltar para a Página de Login
                        </a>
                    </div>
                </div>
            {% else %}
                <div>
                    <div class="mb-6 text-center">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400">Primeiro Acesso</p>
                        <h1 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">Defina sua Senha</h1>
                        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                            Olá, <strong class="text-slate-700 dark:text-slate-200">{{ user.name }}</strong>! Crie uma senha para acessar com seu e-mail <strong class="text-slate-700 dark:text-slate-200">{{ user.email }}</strong>.
                        </p>
                    </div>

                    {% if error %}
                        <div class="mb-6 rounded-xl bg-red-50 p-4 border border-red-200 text-sm text-red-700 dark:bg-red-950/30 dark:border-red-900/50 dark:text-red-300 flex items-start gap-3">
                            <sl-icon name="exclamation-circle" class="text-lg shrink-0 mt-0.5"></sl-icon>
                            <div>{{ error }}</div>
                        </div>
                    {% endif %}

                    <form method="post" class="space-y-5">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password_' ~ token) }}">

                        <div>
                            <label for="password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                Nova Senha
                            </label>
                            <input type="password" 
                                   id="password" 
                                   name="password" 
                                   required 
                                   minlength="6"
                                   autocomplete="new-password"
                                   placeholder="Mínimo de 6 caracteres"
                                   class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:placeholder-slate-500 dark:focus:bg-slate-800 transition-colors">
                        </div>

                        <div>
                            <label for="confirm_password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                Confirme a Nova Senha
                            </label>
                            <input type="password" 
                                   id="confirm_password" 
                                   name="confirm_password" 
                                   required 
                                   minlength="6"
                                   autocomplete="new-password"
                                   placeholder="Repita a senha digitada"
                                   class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:placeholder-slate-500 dark:focus:bg-slate-800 transition-colors">
                        </div>

                        <div class="pt-2">
                            <button type="submit" 
                                    class="w-full rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/20 hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                                <sl-icon name="check2-circle" class="text-lg"></sl-icon>
                                <span>Salvar Senha e Acessar</span>
                            </button>
                        </div>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
