<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
        <h3 class="text-2xl font-bold text-gray-900 mb-2">{{ definition ? definition.lemma : 'Unknown' }}</h3>
        <p class="text-lg text-gray-600 mb-4">{{ definition ? definition.transliteration : '' }}</p>
        
        <div class="bg-gray-50 p-4 rounded border border-gray-200 mb-4">
            <h4 class="font-bold text-gray-700 mb-2">Strong: {{ strongCode }}</h4>
            <div class="text-gray-800 mb-2">
                <strong>Definição:</strong> 
                <div class="mt-1">{{ formattedDefinition ? formattedDefinition|raw : 'Definição não encontrada.' }}</div>
            </div>
            <div class="text-gray-600 text-sm mt-2">{{ formattedFullDefinition ? formattedFullDefinition|raw : '' }}</div>
            <div class="mt-4">
                <a href="https://search.nepebrasil.org/strongs/?id={{ strongCode }}" target="_blank" class="text-blue-600 hover:underline text-sm">
                    Ver no NEPE →
                </a>
            </div>
        </div>


        {% if louwNidaInfos is defined and louwNidaInfos|length > 0 %}
        <div class="mt-6">
            <h4 class="font-bold text-gray-900 mb-2">Domínios Semânticos (Louw-Nida)</h4>
            
            <div class="bg-indigo-50 rounded border border-indigo-100 divide-y divide-indigo-100 max-h-80 overflow-y-auto">
                {% for info in louwNidaInfos %}
                    {% if info|length > 0 %}
                    <div class="p-3">
                        {# LN Number and Domain info #}
                        <div class="flex items-center gap-2 mb-2">
                            {% if info.lnNumber is defined %}
                            <a href="{{ path('admin_louwnida', {word: info.lnNumber}) }}" target="_blank" class="bg-purple-100 text-purple-800 text-xs font-semibold px-2 py-0.5 rounded hover:bg-purple-200 transition-colors">
                                {{ info.lnNumber }}
                            </a>
                            {% endif %}
                            {% if info.category is defined %}
                            <a href="{{ path('admin_louwnida', {word: 'LN-' ~ info.lnNumber|replace({'LN-': ''})|split('.')|first}) }}" target="_blank" class="bg-indigo-100 text-indigo-800 text-xs font-semibold px-2 py-0.5 rounded hover:bg-indigo-200 transition-colors">
                               LN-{{ info.lnNumber|replace({'LN-': ''})|split('.')|first }}:{{ info.category }}
                            </a>
                            <a href="{{ path('admin_louwnida', {word: info.lnNumber}) }}" target="_blank" class="bg-indigo-100 text-indigo-600 text-xs font-semibold px-2 py-0.5 rounded hover:bg-indigo-200 transition-colors">
                               {{ info.lnNumber }} {{ info.glossPortuguese }} <i>({{ info.glossEnglish }})</i>
                            </a>
                            {% endif %}
                        </div>
                        

                        
                        {# Sense info from LouwNidaSense #}
                        {% if info.ideiaCentralPtBr is defined and info.ideiaCentralPtBr %}
                        <div class="bg-green-50 border-l-4 border-green-400 p-2 mt-2 rounded-r">
                            <div class="text-xs font-semibold text-green-700 uppercase mb-1">Ideia Central</div>
                            <div class="text-sm text-gray-800">{{ info.ideiaCentralPtBr }}</div>
                        </div>
                        {% endif %}
                        
                        {% if info.sentidoSemanticoPtBr is defined and info.sentidoSemanticoPtBr %}
                        <div class="bg-blue-50 border-l-4 border-blue-400 p-2 mt-2 rounded-r">
                            <div class="text-xs font-semibold text-blue-700 uppercase mb-1">Sentido Semântico</div>
                            <div class="text-sm text-gray-800">{{ info.sentidoSemanticoPtBr }}</div>
                        </div>
                        {% endif %}
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        {% elseif contextualDomain or (louwNidaDomains and louwNidaDomains|length > 0) %}
        <div class="mt-6">
            <h4 class="font-bold text-gray-900 mb-2">Domínios Semânticos (Louw-Nida)</h4>
            
            {% if contextualDomain %}
                <div class="mb-4 bg-green-50 rounded-lg border border-green-200 p-4 shadow-sm relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-green-600 text-white text-[10px] uppercase font-bold px-2 py-0.5 rounded-bl">
                        Contexto Atual
                    </div>
                    <div class="flex items-center gap-2 mb-2">
                        <a href="{{ path('admin_louwnida', {word: 'LN-' ~ contextualDomain.domainNumber ~ '.' ~ contextualDomain.subdomainNumber}) }}" target="_blank" class="bg-green-100 text-green-800 text-xs font-semibold px-2 py-0.5 rounded border border-green-200 hover:bg-green-200 transition-colors">
                             LN-{{ contextualDomain.domainNumber }}.{{ contextualDomain.subdomainNumber }}
                        </a>
                        <a href="{{ path('admin_louwnida', {word: 'LN-' ~ contextualDomain.domainNumber}) }}" target="_blank" class="text-sm font-bold text-gray-900 hover:text-green-700 transition-colors">{{ contextualDomain.category }}</a>
                    </div>
                     <div class="text-sm text-gray-700 leading-relaxed">
                         <div class="mb-1"><strong class="text-green-900">{{ contextualDomain.glossPortuguese }}</strong></div>
                         {% if contextualDomain.glossEnglish %}
                            <div class="text-gray-500 text-xs italic">{{ contextualDomain.glossEnglish }}</div>
                         {% endif %}
                    </div>
                </div>
                
                {% if louwNidaDomains|length > 0 %}
                    <h5 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 mt-6">Todos os Sentidos Globais</h5>
                {% endif %}
            {% endif %}

            {% if louwNidaDomains and louwNidaDomains|length > 0 %}
                <div class="bg-indigo-50 rounded border border-indigo-100 divide-y divide-indigo-100 max-h-60 overflow-y-auto">
                    {% for domain in louwNidaDomains %}
                        <div class="p-3 {{ contextualDomain and contextualDomain.id == domain.id ? 'bg-green-50/50' : '' }}">
                            <div class="flex items-center gap-2 mb-1">
                                <a href="{{ path('admin_louwnida', {word: 'LN-' ~ domain.domainNumber ~ '.' ~ domain.subdomainNumber}) }}" target="_blank" class="bg-indigo-100 text-indigo-800 text-xs font-semibold px-2 py-0.5 rounded hover:bg-indigo-200 transition-colors">
                                    LN-{{ domain.domainNumber }}.{{ domain.subdomainNumber }}
                                </a>
                                <a href="{{ path('admin_louwnida', {word: 'LN-' ~ domain.domainNumber}) }}" target="_blank" class="text-sm font-medium text-gray-800 hover:text-indigo-700 transition-colors">{{ domain.category }}</a>
                            </div>
                            <div class="text-sm text-gray-600">
                                 <strong>{{ domain.glossPortuguese }}</strong>
                                 {% if domain.glossEnglish %}
                                    <span class="text-gray-400 mx-1">•</span> {{ domain.glossEnglish }}
                                 {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        {% endif %}
    </div>

    <div>
        <h4 class="font-bold text-gray-900 mb-4">Ocorrências (Paradigm)</h4>
        
        {% if paradigms|length > 0 %}
            <div class="space-y-4">
                {# Chart #}
                <div class="h-64 w-full bg-gray-50 rounded border border-gray-200 p-4 flex flex-col justify-end">
                    <div class="flex items-end gap-2 h-48 border-b border-gray-300 pb-1">
                        {% set maxAmount = 0 %}
                        {% for p in paradigms %}
                            {% if p.amount > maxAmount %}
                                {% set maxAmount = p.amount %}
                            {% endif %}
                        {% endfor %}

                        {% set colors = ['bg-red-500', 'bg-orange-500', 'bg-amber-500', 'bg-yellow-500', 'bg-lime-500', 'bg-green-500', 'bg-emerald-500', 'bg-teal-500', 'bg-cyan-500', 'bg-sky-500', 'bg-blue-500', 'bg-indigo-500', 'bg-violet-500', 'bg-purple-500', 'bg-fuchsia-500', 'bg-pink-500'] %}

                        {% for p in paradigms|slice(0, 10) %}
                            {% set height = (p.amount / maxAmount) * 100 %}
                            {% set colorClass = colors[loop.index0 % colors|length] %}
                            
                            <div class="flex-1 flex flex-col items-center group relative h-full justify-end">
                                {# Bar #}
                                <div class="w-full {{ colorClass }} hover:opacity-80 rounded-t transition-all relative" style="height: {{ height }}%;">
                                    {# Tooltip #}
                                    <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 hidden group-hover:block bg-gray-900 text-white text-xs rounded p-2 z-10 whitespace-nowrap shadow-lg">
                                        <strong>{{ p.translation }}</strong><br>
                                        Qtd: {{ p.amount }}<br>
                                        {{ p.rmacDescription }}
                                        <div class="absolute top-full left-1/2 transform -translate-x-1/2 border-4 border-transparent border-t-gray-900"></div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    
                    {# Labels #}
                    <div class="flex gap-2 mt-2">
                        {% for p in paradigms|slice(0, 10) %}
                            <div class="flex-1 text-center">
                                <div class="text-[10px] text-gray-600 truncate w-full" title="{{ p.translation }}">
                                    {{ p.translation }}
                                </div>
                                <div class="text-[9px] text-gray-400 font-mono">
                                    {{ p.amount }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Table #}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 text-sm">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Tradução</th>
                                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Morfologia</th>
                                <th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase">Qtd</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for p in paradigms %}
                                <tr>
                                    <td class="px-3 py-2 whitespace-nowrap font-medium text-gray-900">{{ p.translation }}</td>
                                    <td class="px-3 py-2 text-gray-500">
                                        <div class="text-xs">{{ p.rmacDescription }}</div>
                                        <div class="text-[10px] text-gray-400 font-mono">{{ p.rmac }}</div>
                                    </td>
                                    <td class="px-3 py-2 whitespace-nowrap text-right text-gray-500">{{ p.amount }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% else %}
            <p class="text-gray-500 italic">Nenhuma ocorrência encontrada na tabela Paradigm.</p>
        {% endif %}

{% if is_granted('CAN_EDIT_TRANSLATION') %}
    <!-- Conteúdo visível apenas para Admin e Tradutor -->
        <button onclick="openAddGlobalModal('{{ term ? term|escape('js') : (definition ? definition.definition|escape('js') : '') }}', '{{ definition ? definition.lemma|escape('js') : '' }}', '{{ strongCode|escape('js') }}', '{{ definition ? definition.transliteration|escape('js') : '' }}', '{{ referenceContent ? referenceContent|escape('js') : (formattedFullDefinition ? formattedFullDefinition|escape('js') : '') }}')" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded transition-colors w-full flex items-center justify-center gap-2">
            <sl-icon name="plus-circle" aria-hidden="true" library="default"></sl-icon>
            Adicionar Referência Global
        </button>

        <button onclick="openAddSpecificModal('{{ term ? term|escape('js') : (definition ? definition.definition|escape('js') : '') }}', '{{ definition ? definition.lemma|escape('js') : '' }}', '{{ definition ? definition.transliteration|escape('js') : '' }}', '{{ referenceContent ? referenceContent|escape('js') : (formattedFullDefinition ? formattedFullDefinition|escape('js') : '') }}')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition-colors w-full flex items-center justify-center gap-2 mt-2">
            <sl-icon name="plus-circle" aria-hidden="true" library="default"></sl-icon>
            Adicionar Referência Específica
        </button>    
{% endif %}



    </div>
</div>
